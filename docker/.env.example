# PostgreSQL
POSTGRES_USER=transcendance_user
POSTGRES_PASSWORD=change_me_secure_password
POSTGRES_DB=transcendance_db

# Backend
DB_HOST=postgres
DB_PORT=5432
DB_USER=transcendance_user
DB_PASSWORD=change_me_secure_password
DB_NAME=transcendance_db
JWT_SECRET=change_me_to_a_long_random_secret
SESSION_SECRET=change_me_to_another_long_random_secret
CORS_ORIGIN=http://localhost:3000
UPLOAD_DIR=./uploads
# Optional comma-separated default avatar URLs for new signups.
# If omitted, the built-in neutral placeholder avatar is used.
DEFAULT_AVATAR_URLS=http://localhost:3000/avatars/default-placeholder.svg

# Frontend
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000
